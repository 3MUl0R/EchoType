{
  "name": "echotype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bash -c 'source .env && tauri dev'",
    "build": "bash -c 'source .env && tauri build'",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .ts,.svelte",
    "lint:fix": "eslint . --ext .ts,.svelte --fix",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "restart": "bun scripts/restart.ts",
    "autostart:enable": "bun scripts/autostart.ts enable",
    "autostart:disable": "bun scripts/autostart.ts disable",
    "autostart:status": "bun scripts/autostart.ts status"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@playwright/test": "^1.58.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/cli": "^2.10.0",
    "@testing-library/svelte": "^5.3.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^17.3.0",
    "jsdom": "^26.0.0",
    "svelte": "^5.53.5",
    "svelte-check": "^4.0.0",
    "svelte-eslint-parser": "^1.5.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
