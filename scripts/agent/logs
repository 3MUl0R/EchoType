#!/usr/bin/env bash
set -euo pipefail

# EchoType logs script
# Prints recent log output from the app data directory.
# Usage: ./scripts/agent/logs [--tail N]

TAIL_LINES=50

while [[ $# -gt 0 ]]; do
  case $1 in
    --tail)
      TAIL_LINES="$2"
      shift 2
      ;;
    *)
      echo "Unknown argument: $1" >&2
      exit 1
      ;;
  esac
done

# Determine log directory based on platform
case "$(uname -s)" in
  Darwin)
    LOG_DIR="$HOME/Library/Application Support/com.echotype.app/logs"
    ;;
  Linux)
    LOG_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/com.echotype.app/logs"
    ;;
  MINGW*|MSYS*|CYGWIN*)
    LOG_DIR="$APPDATA/com.echotype.app/logs"
    ;;
  *)
    echo "status=error hint=\"Unknown platform: $(uname -s)\"" >&1
    exit 1
    ;;
esac

if [ ! -d "$LOG_DIR" ]; then
  echo "status=empty hint=\"No log directory found at $LOG_DIR. Run the app first.\"" >&1
  exit 0
fi

# Find the most recent log file
LATEST_LOG=$(find "$LOG_DIR" -name "*.log*" -type f 2>/dev/null | sort -r | head -1)

if [ -z "$LATEST_LOG" ]; then
  echo "status=empty hint=\"No log files found in $LOG_DIR\"" >&1
  exit 0
fi

echo "status=ok file=$LATEST_LOG" >&1
tail -n "$TAIL_LINES" "$LATEST_LOG"
